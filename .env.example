# 복사해서 .env로 만든 뒤 값을 채운다. .env는 커밋하지 않는다.

# 선택: GitHub API 토큰 (없으면 익명 호출, 레이트 리밋이 낮다)
GITHUB_TOKEN=

# 선택: GitHub 웹훅 시크릿 (설정하면 서명 검증 강제)
GITHUB_WEBHOOK_SECRET=

# 선택: LLM 뉴스 추출 (없으면 임시 조치·제품명은 비어 있음)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# 폴링 주기 (초)
NEWS_INTERVAL=300
KEV_INTERVAL=600
GH_INTERVAL=900

# 첫 실행 때 과거 몇 일치까지 처리할지
LOOKBACK_DAYS=7

# 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:8080

# SQLite 파일 경로
DB_PATH=data/app.db
